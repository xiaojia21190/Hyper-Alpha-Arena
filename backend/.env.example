# Hyper Alpha Arena - Environment Configuration

# =================================================================
# Hyperliquid Trading Configuration
# =================================================================

# Encryption key for private key storage (REQUIRED for Hyperliquid trading)
# Generate with: python utils/encryption.py
# Keep this secret! If lost, you cannot decrypt stored private keys.
HYPERLIQUID_ENCRYPTION_KEY=your-encryption-key-here

# Hyperliquid environment defaults
# These can be overridden per account in the database
HYPERLIQUID_MAX_LEVERAGE=10
HYPERLIQUID_MIN_ORDER_VALUE=10.0
HYPERLIQUID_MAX_POSITION_VALUE_PER_ORDER=1000.0

# =================================================================
# API Configuration (existing)
# =================================================================

# Runtime key precedence:
# 1) explicit shell env
# 2) backend/.env
# 3) start_local.sh fallback defaults
#
# Startup profile for server runtime.
# When not set in shell env, this value overrides script fallback defaults.
# - factor: start Hyperliquid factor runtime services with lower server CPU usage
# - full: start all collectors, schedulers, trading services, and bot restores
# - api: API/UI only, skips background services for diagnostics/admin usage
APP_RUNTIME_PROFILE=factor

# When not set in shell env, this value overrides script fallback defaults.
# Keep watcher disabled for server deployments unless you are actively editing frontend files.
FRONTEND_WATCHER_ENABLED=false

# Factor runtime defaults.
# These defaults turn on factor computation and the automated research loop.
# Automatic live promotion stays off by default; manual confirmation remains required.
FACTOR_ENGINE_ENABLED=true
FACTOR_RESEARCH_ENABLED=true
FACTOR_RESEARCH_RUN_ON_STARTUP=true
FACTOR_RESEARCH_AUTO_PROMOTE_PAPER=true
FACTOR_RESEARCH_PAPER_ACCOUNT_ID=0
FACTOR_RESEARCH_AUTO_PROMOTE_LIVE=false
FACTOR_RESEARCH_LIVE_ACCOUNT_ID=0
FACTOR_RESEARCH_REQUIRE_LIVE_CONFIRM=true

# Add your other environment variables below...
